DB_URL=jdbc:postgresql://localhost:5432/stwmovers
DB_USER=stwmovers
DB_PASSWORD=stwmovers
# UNUSED while Redis disabled (OTP uses in-memory store). Re-enable: uncomment application.yml redis block and restore Redis starter.
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=replace-with-256-bit-secret
# Same OAuth Web client ID as NUXT_PUBLIC_GOOGLE_CLIENT_ID (Google Cloud Console)
GOOGLE_CLIENT_ID=
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be a sender verified in Brevo (usually same as MAIL_USERNAME)
MAIL_FROM=
# If port 587 fails with MailConnectException, try: MAIL_PORT=465 MAIL_SSL_ENABLE=true MAIL_STARTTLS_ENABLE=false
MAIL_SSL_ENABLE=false
MAIL_STARTTLS_ENABLE=true
MAIL_DEBUG=false
CORS_ORIGINS=http://localhost:3000
# Headless WordPress + Rank Math (public blog API for Nuxt)
WORDPRESS_BASE_URL=https://cms.stwmovers.com
PUBLIC_SITE_URL=https://stwmovers.com
BLOG_PATH_PREFIX=/blogs
BLOG_CACHE_TTL=PT15M
ADMIN_EMAIL=admin@stwmovers.com
ADMIN_PASSWORD=Admin@12345
