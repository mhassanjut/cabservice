NUXT_PUBLIC_API_BASE_URL=http://localhost:8080
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# OAuth 2.0 Web client ID from Google Cloud Console (same value as backend GOOGLE_CLIENT_ID)
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
# Must be true when backend uses HttpOnly cookie auth (auth.withoutTokens())
NUXT_PUBLIC_COOKIE_AUTH=true
# Optional for hosted Checkout redirect (pk_test_… from Stripe Dashboard)
NUXT_PUBLIC_STRIPE_PUBLIC_KEY=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Microsoft Clarity project ID
NUXT_PUBLIC_MICROSOFT_CLARITY_ID=
