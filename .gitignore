########################################
# IDE / Editors
########################################

.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# Eclipse (if used)
.metadata/
.settings/
.project
.classpath
.recommenders/

########################################
# OS files
########################################

.DS_Store
Thumbs.db
Desktop.ini

########################################
# Dependencies (never commit installed packages)
########################################

node_modules/
.pnp/
.pnp.js

########################################
# Nuxt / frontend build outputs
# NOTE: Do NOT ignore source files (*.vue, *.ts, *.css, etc.) — only generated output.
########################################

.nuxt/
.output/
dist/
dist-ssr/
.server/
.nitro/
.vercel/
.netlify/

########################################
# Java / Maven build outputs
# NOTE: Do NOT ignore source (*.java, pom.xml, src/**).
########################################

target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Maven release plugin backups
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Spring Boot
.spring-boot-devtools.properties

########################################
# Logs
########################################

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

########################################
# Runtime / system files
########################################

pids/
*.pid
*.seed
*.pid.lock

########################################
# Coverage / testing
########################################

coverage/
*.lcov

########################################
# Environment variables (secrets)
########################################

.env
.env.*
!.env.example

########################################
# Cache directories
########################################

.cache/
.parcel-cache/
.eslintcache
.nuxt-cache/
.nitro-cache/

########################################
# Build tools / other frameworks
########################################

build/
.swc/
.turbo/
.next/
.storybook/

########################################
# Temporary / local scratch files
########################################

*.tmp
*.temp
**/tmp-*.json

########################################
# Redis local data dumps (dev artifacts)
########################################

dump.rdb
*.rdb

########################################
# Backend: Redis Windows binaries (from scripts/setup-redis.ps1)
########################################

stwmovers-backend/tools/redis/*.exe
stwmovers-backend/tools/redis/*.pdb
stwmovers-backend/tools/redis/*.zip

########################################
# Frontend: portable/offline npm overlay (generated; see portable/README.txt)
########################################

stwmovers-frontend/portable/node_modules/
stwmovers-frontend/portable/packages/

# Frontend: generated vehicle image scratch (see scripts/download-vehicle-images.mjs)
stwmovers-frontend/.tmp-vehicle-previews/
stwmovers-frontend/public/img/vehicles/_raw/

# Backend: optional npm scratch at repo root (not used by Maven build)
stwmovers-backend/package.json

# Backend: admin-uploaded car images (runtime; served from /api/v1/media/cars/)
stwmovers-backend/uploads/

########################################
# Package manager lock files
########################################
stwmovers-frontend/package-lock.json
# yarn.lock
# pnpm-lock.yaml

########################################
# Keep this file reference safe
########################################

!project-structure.txt
